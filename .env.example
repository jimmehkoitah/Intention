# Supabase — project URL and publishable (anon) key.
# The anon key is public by design; row-level security is what protects data.
# This app deliberately does NOT use a service-role / secret key anywhere.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key

# GitHub OAuth App (Settings -> Developer settings -> OAuth Apps).
# Callback URL must be <APP_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Twitch (dev.twitch.tv/console/apps — requires 2FA on the account)
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# Optional: AI search and summaries. Unset simply disables those routes.
# OPENAI_API_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
